# Server and database
NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/smart-room-finder

# Use long, unique secrets in every deployed environment.
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:5173

# OTP / SMS. No OTP is returned or logged by the API.
SMS_PROVIDER=disabled
SMS_API_KEY=
SMS_API_SECRET=
SMS_FROM=
OTP_TTL_MINUTES=10
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5

# Optional external integrations
AI_PROVIDER=disabled
AI_API_KEY=
AI_MODEL=
MAP_PROVIDER=disabled
MAPS_API_KEY=
STORAGE_PROVIDER=disabled
STORAGE_API_KEY=
STORAGE_API_SECRET=
STORAGE_BUCKET=
MAX_UPLOAD_BYTES=5242880
