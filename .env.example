# Application
NODE_ENV=development
PORT=5000
FRONTEND_ORIGIN=http://localhost:5173
VITE_API_URL=http://localhost:5000/api

# Database
MONGODB_URI=mongodb://127.0.0.1:27017/smart-room-finder

# Authentication — generate long, unique values for each environment
JWT_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# SMS / OTP provider
SMS_PROVIDER=console
SMS_API_KEY=
SMS_API_SECRET=
SMS_FROM=

# AI provider
AI_PROVIDER=rules
AI_API_KEY=
AI_MODEL=

# Maps provider
MAP_PROVIDER=none
MAPS_API_KEY=

# Object storage provider
STORAGE_PROVIDER=local
STORAGE_API_KEY=
STORAGE_API_SECRET=
STORAGE_BUCKET=
STORAGE_REGION=
